    },
    {
      "id": "FCT-17962820d0fa0829",
      "text": "Zümrüt Ejderha Şifa Tapınağı'nda hafızasını kaybetmiş olarak Köpo Kurtoğlu ile birlikte uyanmıştır.",
      "assertions": [
        {
          "period": null,
