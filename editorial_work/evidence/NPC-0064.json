        }
      ]
    },
    {
      "id": "FCT-dda6accbc697edb4",
      "text": "Pastırman'a dua ederek (Ham et çürür, tuzlanan dayanır...) Dev Fener Balığı'nın çenesini Kalender ile birlikte kırmış, ardından boyut boşluğuna çekilmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP07",
              "pointer": "/entities/5/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-4dcba34e1bd0ec75",
      "text": "Köpo Kurtoğlu ile birlikte Dev Fener Balığı'nın ağzındaki kozmik karanlıkta kaybolmuştur; nihai akıbeti belirsizdir.",
