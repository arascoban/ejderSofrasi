  "facts": [
    {
      "id": "FCT-1999ca593c5317f9",
      "text": "At büyüklüğünde, kısa bacaklı, sırtı kalın zırh plakalarıyla kaplı, gaga çeneli ve kuyruğunun ucunda sivri taşlar/boynuzlar bulunan zırhlı otobur yaratık.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP04",
              "pointer": "/entities/14/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-78b3358f2ff18686",
      "text": "Sert çenesiyle dalları ve ağaçları ezebilir; kuyruk darbesiyle Kalender'e 24 hasar verip böğrünü delmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP04",
