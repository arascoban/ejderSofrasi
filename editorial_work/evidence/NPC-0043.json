  "facts": [
    {
      "id": "FCT-3c92cbe6cc810b23",
      "text": "Kervansaray'ın gözcübaşı; kafasında dev güneş şapkası bulunan, zırhlı, pazarlıkçı ve rüşvetçi orta yaşlı muhafız komutanı.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP20",
              "pointer": "/entities/8/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-bca4e1f8d72f9b40",
      "text": "Yaz Helvası'ndan gelenleri içeri almama kuralına rağmen, hastalanan hayvanların iyileştirilmesi şartıyla maceracıları Kervansaray'a kabul etmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP20",
              "pointer": "/entities/8/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-29402fee9dd54a50",
      "text": "Tahin Saray Kervansarayı muhafızlarının başı (gözcübaşı).",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP21",
              "pointer": "/entities/6/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-3465933d5a99b95e",
      "text": "İto ile gizlice görüşerek handa huzursuzluk çıkaran ve zengin müşterileri rahatsız eden Hulusi'nin 'ortadan kaybolması' karşılığında ekibe 2. katta lüks oda tahsis edeceğini vaat etmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP21",
              "pointer": "/entities/6/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-486f965c7c650e7d",
      "text": "Tahin Saray Kervansarayı gözcübaşısı; kaçış esnasında kervansarayda kargaşa çıkınca çağrılan muhafız amiri.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP22",
              "pointer": "/entities/7/facts/0"
            }
          ]
        }
      ]
    }
  ],
