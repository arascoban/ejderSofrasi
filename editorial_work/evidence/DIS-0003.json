            }
          ]
        }
      ]
    },
    {
      "id": "FCT-9c156a099f014805",
      "text": "En dış mahalle; yoksul halkın, mülteci çadırlarının, toplu mezarların ve harabe binaların bulunduğu alan.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP17",
              "pointer": "/entities/23/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-d4c16d68f48a3a86",
      "text": "Harabe binaların, toplu mezarların ve gariban yaralıların bulunduğu en dış bölge; Kalender'in bayılmasıyla 'Mehdi öldü' kaosunun yaşandığı mahalle.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP19",
              "pointer": "/entities/17/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-91f81efa895c426e",
      "text": "Siyah Ordu tarafından girilip sivilleri katledilen ve yakılan dış şehir bölgesi.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
