  "facts": [
    {
      "id": "FCT-48926a990f0fab04",
      "text": "Şehrin en dış bölgesi; mancınık atışlarında en çok hasar gören mahalle.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP16",
