  "facts": [
    {
      "id": "FCT-eb47b5b913eab83d",
      "text": "Yaz Helvası Krallığı Arifler Okulu'nun istihbarat ve güvenlik işlerinden sorumlu, şık aristokrat kıyafetli, ince uzun yılan bıyıklı ve gözlüklü görevlisi.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP12",
              "pointer": "/entities/6/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-2282909097999466",
      "text": "Müştemilattaki tabut kapılı bir ofiste çalışır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP12",
              "pointer": "/entities/6/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-fd6f8fdda66baa5b",
      "text": "Siyah Ejderha ajanlarının cesetlerinin sorgulanması için ekip görevlendirildiğini, ancak ölülerin her zaman doğruyu söylemeyebileceğini belirtmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP12",
              "pointer": "/entities/6/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-a7e6b30dffdc630d",
      "text": "Çöl Şehri'nin 3. Bölgesi üzerindeki büyülü kubbeye takip ve koruma büyüleri yerleştirildiğini açıklamıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP12",
              "pointer": "/entities/6/facts/3"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-3cc278a929b42f28",
      "text": "Arifler Okulu istihbarat ve güvenlik yöneticisi.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP13",
              "pointer": "/entities/5/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-acbe2c8555b0e24a",
      "text": "Kışla toplantı odasında Kızıl Komutan'ın yanında yer almış, şehirde öldürülen Siyah Ejderha ajanları raporunu sunmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP13",
              "pointer": "/entities/5/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-d94c37b80dc2aa1a",
      "text": "İto'nun komutana saldırması üzerine masanın altına yuvarlanarak saklanmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP13",
              "pointer": "/entities/5/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-a15f0425acbbee0d",
      "text": "Arifler Okulu istihbarat yöneticisi.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP14",
              "pointer": "/entities/11/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-c5ab3ae2f5bf95fa",
      "text": "Batan Güneş Kahvesi'ndeki toplantıya askerlerle birlikte katılmış, ortam gerilince dışarı çıkmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP14",
              "pointer": "/entities/11/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-2116e637865c9ec4",
      "text": "Arifler Okulu istihbarat yöneticisi; patlama sonrası ortadan kaybolduğu için hainlik şüphesiyle aranmaktadır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP15",
              "pointer": "/entities/10/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-0749e955882b34a6",
      "text": "Sancar Devran tarafından öldürüldüğü açıklanan (hainlik/casusluk şüphesiyle) Arifler Okulu eski istihbarat yöneticisi.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP17",
              "pointer": "/entities/10/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-02cc9ff59cc59986",
      "text": "Şebekem'in hain olduğu sonraki bölümlerde açığa çıkar; Siyah Ejderha ajanlarının şehre sızmasına büyük ihtimalle yardım etmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "owner_confirmation",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
              "pointer": "/uncertainties/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-e11ff647db0c16a1",
      "text": "Patlama sonrası nerede olduğu kesin değildir. Siyah Ejderha suikastçısının sorgulanmasıyla ajan olduğu açığa çıkmış ve Kızıl Komutan tarafından ekran dışında öldürülmüştür.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "owner_confirmation",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP15",
              "pointer": "/uncertainties/0"
            },
            {
              "source_id": "SRC-EP17",
              "pointer": "/uncertainties/1"
            }
          ]
        }
      ]
    }
  ],
