  "facts": [
    {
      "id": "FCT-d4d957e53da772b0",
      "text": "Un Helvası ve İrmik Helvası krallıklarını arkasına alan, savaşçı ve yıkıcı ejderha.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/15/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-5855cd40375d7b5d",
      "text": "Düzenbaz, kafa karıştırıcı, insanları ve ejderhaları manipüle etmeye çalışan, kan ve zulüm odaklı ejderha.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
