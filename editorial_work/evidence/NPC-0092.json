  "facts": [
    {
      "id": "FCT-5fedc5772aadd0b5",
      "text": "Gümüş Ejderha Tapınağı'nın arka odasında görev yapan, siyah saçları otlar ve çiçeklerle örülü Yeşim/Zümrüt Ejderha rahibesi.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
              "pointer": "/entities/5/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-61303818063bd0a3",
      "text": "Akmer'in duasını ve taşıdığı büyülü yadigarları Yeşim Ejderha'nın bir işareti kabul etmiş, maceracıları kuşatılmış şehre umut olmaları için ön saflara yönlendirmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
              "pointer": "/entities/5/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-81b52a721c21a360",
      "text": "Akmer'in elini öpüp alnına koyarak ekibi kutsamıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
              "pointer": "/entities/5/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-3ba814147143bc9f",
      "text": "Yeşim rahipleri arasında üst kademe rütbededir.",
