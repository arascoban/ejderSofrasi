  "facts": [
    {
      "id": "FCT-0fa091872e45f665",
      "text": "Karapancar gemisinde tayfa/denizcidir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP03",
              "pointer": "/entities/5/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-1b5f5acf9f1e45dc",
      "text": "Harita okuyabildiğini söylemiş ancak rotayı ve seyrüsefer yönünü tam bilmediğini, sadece adayı teşhis edebildiğini belirtmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP03",
              "pointer": "/entities/5/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-288c02fab3e11d14",
      "text": "Gizemler Adası'nda karaya çıkan keşif ekibine katılmış, sivri tepeyi tespit ederek göletin yerini göstermiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP03",
              "pointer": "/entities/5/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-5daa1b078eda5920",
      "text": "Karapancar gemisinde haritadan sorumlu tayfadır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP04",
              "pointer": "/entities/4/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-ae2cf0fce71b91f3",
      "text": "Gizemler Adası'nın tepesinden bakıldığında adanın haritaya göre çok daha büyük olduğunu ve Adnan Körkapak'ın timsahlarla dolu bu kadar zorlu bir adaya hazine gömmüş olamayacağını düşünerek şüpheye düşmüştür.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP04",
              "pointer": "/entities/4/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-26df9e9c3636c94e",
      "text": "Akmer ve ekibe haritada gösterilen derenin paralelinde ilerleyip beyaz dumanın çıktığı açıklığı hedeflemelerini önermiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP04",
              "pointer": "/entities/4/facts/2"
            }
          ]
        }
      ]
    }
