  "facts": [
    {
      "id": "FCT-7323159527ea1eb9",
      "text": "Siyah Ejderha faksiyonu adına çalışan, çıkmaz sokakta maceracılara pusu kuran kıllı ve zırhlı düşman suikastçı lideri.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
              "pointer": "/entities/6/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-2714630a5952f4e2",
      "text": "Yaralı kadın kılığındaki ajanı kullanarak maceracıları kapana kıstırmış, Kalender'in boğazına bıçak dayamıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
              "pointer": "/entities/6/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-a90e6ff601076b6b",
      "text": "İto'nun hançer darbesi ve Kalender'in Işık Tacı ile kör edilmiş, kaçmaya çalışırken İto tarafından okla vurularak öldürülmüştür.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
              "pointer": "/entities/6/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-148852e25ca4579d",
      "text": "Siyah Ejderha faksiyonu adına çalışan, EP09'daki pusuda öldürülen suikastçı lideri.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP10",
              "pointer": "/entities/4/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-1fbb92d9f8b68f23",
      "text": "Üzerinden rulo parşömen, çöl tepesine çökmüş ejderha armalı siyah mühür yüzüğü, sembollü hançer ve yabancı ülke paraları çıkmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP10",
              "pointer": "/entities/4/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-da863149ec541bdc",
      "text": "Siyah Ejderha Cambazları'nın lideri olması muhtemeldir, ancak bu liderlik kesin olarak doğrulanmamıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "owner_confirmation",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP10",
              "pointer": "/links/9"
            }
          ]
        }
      ]
    }
  ],
