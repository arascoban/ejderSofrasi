  "facts": [
    {
      "id": "FCT-e66cff27d8a7d618",
      "text": "Zümrüt Ejderha Şifa Tapınağı'nın hazine odasında Taç görünümünde ışıklı olta uzvu (lure) bulunduran, kozmik karanlıkta/uzay boşluğunda yaşayan devasa yırtıcı yaratık.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP06",
              "pointer": "/entities/6/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-011e90730387a1cc",
      "text": "Kalender'i zihinsel olarak büyüleyip ısırmış (48 hasar) ve Kalender ile ona tutunan İto'yu yutarak başka bir evrene/boyuta sürüklemiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP06",
              "pointer": "/entities/6/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-15aaaf2ea2cf48bf",
      "text": "Farklı boyutlar arasında avlanan, boyut kesişiminde ortaya çıkan ve ağzında insanları yutan kozmik canavar.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP07",
              "pointer": "/entities/8/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-8f1144bfb2d17cac",
      "text": "Kalender ve Meşrep'in ortak duası ve ilahi kuvvetiyle çenesi kırılmış, ardından Pastırman'ın çemli pastırma kaplı devasa demir eldiveni (Guntlet) tarafından çekilerek karanlığa gömülmüştür.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP07",
              "pointer": "/entities/8/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-4cac4886079532b3",
      "text": "İto'nun kafasındaki lanetli gözlü tacın ve sırtındaki ağzın kaynağı olan kozmik yaratık.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP12",
              "pointer": "/entities/18/facts/0"
            }
          ]
        }
      ]
    }
  ],
