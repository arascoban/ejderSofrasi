  "facts": [
    {
      "id": "FCT-97d8dd0dd274728c",
      "text": "Helvanar Çölü'nde geceleyin Vaha olarak görünen, sabah vakti ortaya çıkan 3 katlı, kumların altına doğru gömülerek uzanan, zamanın durduğu (güneşin sabit kaldığı, sıcaklık hasarı verilmediği) kadim ziyafet mabedi.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP23",
              "pointer": "/entities/7/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-23ed6cbb5ec1d6c4",
      "text": "İlk salonunun zemini limonlu hardal sosuyla, ikinci salonunun zemini acı biberli tereyağı ve füme et sosuyla kaplıdır; kapılarında Şef Ejderha kabartmaları bulunur.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP23",
              "pointer": "/entities/7/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-8c6b2c4867fdd2d1",
      "text": "9 Ulu Ejderha tarafından evrenin lezzet denemeleri için inşa edilmiş, ideal bulunmayan tariflerin ve canlı sosların biriktirildiği 7 katlı dikey ziyafet kuyusu/mabedi.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP24",
              "pointer": "/entities/13/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-22621a316c30ea0e",
      "text": "Harabelerin fiziksel konumu veya başka bir boyutla ilişkisi hikâyenin bu aşamasında açıklanmamıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "owner_confirmation",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP23",
              "pointer": "/uncertainties/1"
            }
          ]
        }
      ]
    }
  ],
