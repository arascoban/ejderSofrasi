    "summary_facts": [
      {
        "fact_id": "FCT-cbbe290e38edfdcb",
        "entity_id": "EVT-0056",
        "fact": {
          "id": "FCT-cbbe290e38edfdcb",
          "text": "Kervansaraydan kaçan ekip iki buçuk saatlik çöl yolculuğundan sonra vahaya sığınır; sabah vahanın yerinde Ejderhalar Sofrası Harabeleri görünür.",
          "assertions": [
            {
              "period": "1300 civarı",
              "temporal_basis": "reviewed_source_context",
              "confidence": "source_supported",
              "source_refs": [
                {
                  "source_id": "SRC-EP23",
                  "pointer": "/entities/3/facts/1"
                },
                {
                  "source_id": "SRC-EP23",
                  "pointer": "/entities/12/facts/0"
                }
              ]
            }
          ]
        }
      },
      {
        "fact_id": "FCT-7f9531cd927af0dd",
        "entity_id": "EVT-0057",
        "fact": {
          "id": "FCT-7f9531cd927af0dd",
          "text": "Ekip, dokuz ejderhanın tasvir edildiği mozaikleri ve Şef Ejderha kapılarını inceler; içerideki asidik sineklerle karşılaşır.",
          "assertions": [
            {
              "period": "1300 civarı",
              "temporal_basis": "reviewed_source_context",
              "confidence": "source_supported",
              "source_refs": [
                {
                  "source_id": "SRC-EP23",
                  "pointer": "/entities/8/facts/0"
                },
                {
                  "source_id": "SRC-EP23",
                  "pointer": "/entities/9/facts/0"
                },
                {
                  "source_id": "SRC-EP23",
                  "pointer": "/entities/6/facts/1"
                }
              ]
            }
          ]
        }
      },
      {
        "fact_id": "FCT-218d518dbea199fa",
        "entity_id": "EVT-0058",
        "fact": {
          "id": "FCT-218d518dbea199fa",
          "text": "Jifa, Roary'nin vizyonunda belirerek ekibin hâlâ tapınak sınavında olduğunu ve sınır dışında zamanın durduğunu söyler; bu fiziksel olarak orada bulunduğunu kanıtlamaz.",
          "assertions": [
            {
              "period": "1300 civarı",
              "temporal_basis": "reviewed_source_context",
              "confidence": "source_supported",
              "source_refs": [
                {
                  "source_id": "SRC-EP23",
                  "pointer": "/entities/3/facts/4"
                },
                {
                  "source_id": "SRC-EP23",
                  "pointer": "/entities/5/facts/1"
                }
              ]
            }
          ]
        }
      },
      {
        "fact_id": "FCT-a541e5813a21d777",
        "entity_id": "EVT-0060",
        "fact": {
          "id": "FCT-a541e5813a21d777",
          "text": "Ekip canlı yağ, tahin ve pekmez engellerini aşar; Kalender tahin kübünden kurtarılır, Roary örümcek formuyla arkadaşlarına yardım eder.",
          "assertions": [
            {
              "period": "1300 civarı",
              "temporal_basis": "reviewed_source_context",
              "confidence": "source_supported",
              "source_refs": [
                {
                  "source_id": "SRC-EP24",
                  "pointer": "/entities/1/facts/2"
                },
                {
                  "source_id": "SRC-EP24",
                  "pointer": "/entities/3/facts/2"
                },
                {
                  "source_id": "SRC-EP24",
                  "pointer": "/entities/8/facts/0"
                }
              ]
            }
          ]
        }
      },
      {
        "fact_id": "FCT-a9e1f3b62554a791",
        "entity_id": "EVT-0061",
        "fact": {
          "id": "FCT-a9e1f3b62554a791",
          "text": "Yokoluş Bey golemi ısırır; Akmer baltasıyla gövdeyi yararak merkezindeki Ametist Kristali'ni dışarı çıkarır.",
          "assertions": [
            {
              "period": "1300 civarı",
              "temporal_basis": "reviewed_source_context",
              "confidence": "source_supported",
              "source_refs": [
                {
                  "source_id": "SRC-EP24",
                  "pointer": "/entities/0/facts/2"
                },
                {
                  "source_id": "SRC-EP24",
                  "pointer": "/entities/4/facts/1"
                }
              ]
            }
          ]
        }
      },
      {
        "fact_id": "FCT-fe17683cebaf0dd2",
        "entity_id": "EVT-0062",
        "fact": {
          "id": "FCT-fe17683cebaf0dd2",
          "text": "Ametist Kristali insanlığın amacının ejderhaların damak tadına hizmet etmek olduğunu iddia eder; bu, kristale atfedilen bir öğreti olarak korunur.",
          "assertions": [
            {
              "period": "1300 civarı",
              "temporal_basis": "reviewed_source_context",
              "confidence": "source_supported",
              "source_refs": [
                {
                  "source_id": "SRC-EP24",
                  "pointer": "/entities/2/facts/4"
                },
                {
                  "source_id": "SRC-EP24",
                  "pointer": "/lore/1"
                }
              ]
            }
          ]
        }
      },
      {
        "fact_id": "FCT-5e7d9469062bff5e",
        "entity_id": "EVT-0064",
        "fact": {
          "id": "FCT-5e7d9469062bff5e",
          "text": "Ametist Kristali mutfak sahnesini canlandırır. Akmer, Kalender ve Roary, Akmer'in kadın atalarının rehberliğiyle sütlaç hazırlayıp sınavı tamamlar.",
          "assertions": [
            {
              "period": "1300 civarı",
              "temporal_basis": "reviewed_source_context",
              "confidence": "source_supported",
              "source_refs": [
                {
