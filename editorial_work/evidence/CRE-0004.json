  "facts": [
    {
      "id": "FCT-4f214dfd6a3afd47",
      "text": "Normalde dağlarda ve ovalarda avlanan, şehir içine girmeyen ancak Niani'nin gizli ıslık çalması üzerine Çöl Şehri semalarında sesi duyulan yırtıcı kuş.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP10",
              "pointer": "/entities/15/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-158e7fb20f12ee84",
      "text": "Çöl Şehri semalarında 800-1000 metre yükseklikte uçan, Kartal Sniper ile büyülü bağ kurup gözcülük eden yırtıcı kuş.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP11",
              "pointer": "/entities/10/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-e547c6da6e8aa597",
      "text": "Kızıl Komutan'ın Oğluna (Kartal Sniper) gözcülük eden, gökyüzünde 6000-9000 metre yükseklikte uçan yırtıcı kuş.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP14",
              "pointer": "/entities/14/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-549aa006d6adca26",
      "text": "Kızıl Komutan'ın Oğluna (Kartal Sniper) gökyüzünden gözcülük eden yırtıcı kuş.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP16",
              "pointer": "/entities/12/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-c77e1e350c2978a9",
      "text": "Gökyüzünde ~3 km (9000 feet) yükseklikte uçarak Devran'a nişangah ve gözcülük sağlayan yırtıcı kuş.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
