  "facts": [
    {
      "id": "FCT-797cf8ccf97c9d39",
      "text": "Çöl Şehri'nin 3. katında yer alan, iklimlendirme büyüsüyle serinletilmiş bahçesi ve havuzu olan, uzgörü (divination) ve kader araştırmaları yapılan büyü okulu/locası.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/13/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-1f868da503ba2dc8",
      "text": "Maceracıların konakladığı, çaycıların ve ıhlamur/orelet ikram edilen bahçenin bulunduğu büyü okulu.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
              "pointer": "/entities/25/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-4eb1a8707fa727e6",
      "text": "Çöl Şehri'nin 3. katında yer alan, alt katlarında Subira'nın büyülü demirhanesi/atölyesi, üst katlarında öğrenci misafirhanesi ve hamamı bulunan büyü okulu.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP11",
              "pointer": "/entities/11/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-9e2b4abcce046651",
      "text": "Çöl Şehri'nin 3. Bölgesi'nde yer alan, kütüphanesi, Subira'nın atölyesi, Şebekem'in müştemilat ofisi ve öğrenci misafirhanesi bulunan uzgörü okulu.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP12",
              "pointer": "/entities/19/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-11ef80668ee90ce1",
      "text": "Uzgörü okulu; bahçesinde kralların gezdiği gül bahçesi barındırır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP14",
              "pointer": "/entities/25/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-578fc192ed265758",
      "text": "Çöl Şehri 3. Bölgesi'nde yer alan, bahçesinde Siyah Ejderha canlı bomba patlaması yaşanan büyü okulu.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP15",
              "pointer": "/entities/22/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-97cee8ed1ec0706e",
      "text": "Büyü okulu; koridorlarında Kalender'in hedef heykellerinin sergilendiği, Subira'nın atölyesini barındıran yer.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP16",
              "pointer": "/entities/27/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-2f61f0c7a5783052",
      "text": "Ammon'un kütüphanede ders verdiği, öğrenciler ve atölyelerin bulunduğu büyü okulu.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP17",
              "pointer": "/entities/30/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-25846b3d3cc585ef",
      "text": "Ammon Hoca'nın kütüphanede eğitim verdiği büyü okulu.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP18",
              "pointer": "/entities/23/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-177c6b7dce36ae8e",
      "text": "Çöl Şehri 3. Bölgesi'ndeki büyü okulu; muhafızların patlama sonrası saldırdığını zannettiği kurum.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP19",
              "pointer": "/entities/26/facts/0"
            }
          ]
        }
      ]
    }
  ],
