  "facts": [
    {
      "id": "FCT-a22d72b62e5c9f35",
      "text": "Çöl Şehri 2. Bölgesi'nde yaşayan, kızı yetersiz beslenme ve kuşatma şartları nedeniyle hasta olan yaşlı kadın.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP12",
              "pointer": "/entities/7/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-09f167db28edc8c6",
      "text": "Sokakta Mehdi'yi (Kalender) görerek kızını iyileştirmesi için evine davet etmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP12",
              "pointer": "/entities/7/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-259a0b323aa6ebbc",
      "text": "Çöl Şehri'nde yaşayan, kızı Kalender tarafından iyileştirilen misafirperver ve yaşlı kadın.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP14",
              "pointer": "/entities/4/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-145b5302cd13fbac",
      "text": "Evine sığınan maceracılara çırpma (yumurtalı dökme), çay, helva ve gözleme hazırlamış, onlara tanınmamaları için çiçekli/desenli çarşaflar vermiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP14",
              "pointer": "/entities/4/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-3f6e257387622b68",
      "text": "Hazırladığı 'çırpma' yemeği mahalle halkı tarafından kutsal kabul edilmektedir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP14",
              "pointer": "/entities/4/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-85dd238707a658a9",
      "text": "Çöl Şehri'nde maceracıların sığınmayı planladığı misafirperver yaşlı kadın.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP19",
              "pointer": "/entities/11/facts/0"
            }
          ]
        }
      ]
    }
