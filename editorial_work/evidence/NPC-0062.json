  "facts": [
    {
      "id": "FCT-feb5740879876bb4",
      "text": "Yaz Helvası Krallığı Çöl Şehri'nin 2. komutanı; kilolu/göbekli, sixpack motifli zırh giyen, bıyıklı, yüzünün kenarında yara izi olan ve yüzükler taşıyan sert mizaçlı komutan.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP18",
              "pointer": "/entities/5/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-9ef9b97593f57c5f",
      "text": "Sancar Devran'ın suikast sonucu ölümünün ardından Çöl Şehri başkomutanlığını ve idaresini üstlenmiş, şehirde sokağa çıkma yasağı ve olağanüstü hal (OHAL) ilan etmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP18",
              "pointer": "/entities/5/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-d6de9ed0d40ffef2",
      "text": "Maceracılardan ve Devran'dan şüphelenmiş, İto'nun sırtındaki parazit ağzın ortaya çıkması üzerine İto ve Roary'yi kışlanın alt nezarethanesine kapattırmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP18",
              "pointer": "/entities/5/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-7f3c78d4fe6d88fc",
      "text": "Savaşı er meydanında pazarlıkla çözmek yerine orduları sur dışına çıkarıp doğrudan meydan muharebesi yapmayı savunmuştur.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP18",
              "pointer": "/entities/5/facts/3"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-23aba3b34e51d18c",
      "text": "Sancar Devran'ın ölümünden sonra Çöl Şehri yönetimini devralan ve sokağa çıkma yasağı (OHAL) ilan eden yeni komutan.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP19",
              "pointer": "/entities/6/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-87b5e68ade676cf2",
      "text": "Sancar Devran'ın ölümünden sonra Çöl Şehri başkomutanlığını devralan, surlardan ateşli oklar attırıp hendekleri yaktıran komutan.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP20",
              "pointer": "/entities/6/facts/0"
            }
          ]
        }
      ]
    }
  ],
