            }
          ]
        }
      ]
    },
    {
      "id": "FCT-faf14ea758a57e5c",
      "text": "Kalender'in Kavurhan'ın yeğeni olduğunu söylemesi üzerine Kavurhan'ın çöl kampına ulak/haber göndermiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP22",
              "pointer": "/entities/6/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-451520fcf72b5d75",
      "text": "Avluda Kalender ve Akmer'i teşhir ederek muhafızları alarma geçirmiş, Akmer'den uçan tekme yemiştir.",
      "assertions": [
