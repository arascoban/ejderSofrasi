  "facts": [
    {
      "id": "FCT-e76f3fc805ffeaa8",
      "text": "Tahin Saray Kervansarayı'nın revirinden sorumlu, bitkisel merhemler ve Çin yağı/Vicks ile hastaları tedavi eden sakallı yaşlı doktor.",
      "assertions": [
