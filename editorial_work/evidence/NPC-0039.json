        }
      ]
    },
    {
      "id": "FCT-af74af15c7ba8209",
      "text": "Kalender'in donunu sorması üzerine onu yatıştırmaya çalışmış, Kalender kapıyı kırırken kafasında büyülü iksir şişesi patlatarak onu bayıltmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP22",
