  "facts": [
    {
      "id": "FCT-01245622d48c1188",
      "text": "Kavurhan Satıroğlu'nun kutsal yadigar kutusunda sakladığı, kabzası ve yüzeyi dikenlerle kaplı, ucu çengel biçimli büyülü/kutsal kılıç.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP19",
              "pointer": "/entities/9/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-5c45798a5e30bee3",
      "text": "Kalender Tütüncüoğlu tarafından kavrandığında dikenleri kullanıcının avcuna saplanır; taşıyıcının Strength değerini 20'ye yükseltir ve kutsal savaş öfkesi bağışlar.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP19",
              "pointer": "/entities/9/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-eb1dfd953e1922df",
      "text": "Kavurhan'ın Kalender'e verdiği, taşıyıcısına +2 Strength ve rage özelliği veren radikal kutsal kılıç; Kalender 20 Wisdom zarıyla kılıcı kınına sokarak zihnini kılıcın etkisinden kurtarmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP20",
              "pointer": "/entities/16/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-f494bd941b6deda1",
      "text": "Kalender'in taşıdığı; Pastırman tarafından reddedildiği için Kalender'in ellerine saplanarak ona zarar veren ve düşen kutsal kılıç.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP24",
              "pointer": "/entities/19/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-bb9235670c58cf68",
      "text": "Kalender'in savaş yemini sonrasında +2 Strength ve Rage sağlayan; yemin bozulduktan sonra Kalender'in ellerine saplanan lanetli/uyumsuz kılıçtır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "owner_confirmation",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP19",
              "pointer": "/uncertainties/0"
            }
          ]
        }
      ]
    }
