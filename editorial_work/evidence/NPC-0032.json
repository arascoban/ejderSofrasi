  "facts": [
    {
      "id": "FCT-5eda6f3d94e2e0a4",
      "text": "Çöl Şehri'nde demircilik yapan, sosyoloji mezunu olduğunu ve 'Ot' dergisinde şiirler yazdığını iddia eden iri yarı esnaf/usta.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP14",
              "pointer": "/entities/7/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-396e6ff1e790d2e5",
      "text": "Kalender'e zincir zırh veya plaka zırh yapmayı teklif etmiş, Batan Güneş Kahvesi'nin kapısını korumuştur.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP14",
              "pointer": "/entities/7/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-9c3c3d5ec14ba696",
      "text": "Arifler Okulu yakınında demirhanesi olan, felsefe ve 'Ejderha Çağında Diyalektik ve Materyalist Felsefe' kitapları okuyan bilge demirci usta.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP15",
              "pointer": "/entities/4/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-544b2fa461760f16",
      "text": "Kalender'e özel sıvı soğutmalı dökme demir zırh tasarlamış, geçici olarak Kalender'in Seremoni Zırhı'nı kiralamıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP15",
              "pointer": "/entities/4/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-c302e5e6f4279a62",
      "text": "Deposundaki Helvacıoğlu Hanedanı'na ait kadim Helvacıoğlu Baltası'nı Akmer'e hediye etmiş, ejderha kemiklerinden yapılma Kristal Kılıç'ı Kalender'e vermiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP15",
              "pointer": "/entities/4/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-947ce3830b1a11d6",
      "text": "Roary'nin Dev Ayı formu için özel zırh ölçüsü almıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP15",
              "pointer": "/entities/4/facts/3"
            }
          ]
        }
      ]
    }
  ],
