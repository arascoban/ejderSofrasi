  "facts": [
    {
      "id": "FCT-50620ad72d4893d0",
      "text": "Rogue / Assassin sınıfı kiralık katildir; parayı son derece invested, kaburgaları görünen, 74 cepli, cılız bir hırsızdır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP07",
              "pointer": "/entities/4/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-85d75c949b90bf7a",
      "text": "Zümrüt Ejderha Şifa Tapınağı'nın beyaz merdivenli odasında hafızasını kaybetmiş halde uyanmış, kendisini sadece 'Köpo' olarak tanıtmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP07",
              "pointer": "/entities/4/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-95c507ad8b718ae8",
      "text": "Akmer ve Roary ile girdiği arbedede ok ve bıçak sallamış; hazine odasında Azize'nin Gözyaşları Kadehi'ni kaparken Dev Fener Balığı tarafından yutulma tehlikesi atlatmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP07",
              "pointer": "/entities/4/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-1c60f073bbdd39bc",
      "text": "Dimensiyonel kargaşada boyut boşluğuna çekilmeden önce çaldığı kadehi ve cüzdanındaki paraları Kalender ve İto'ya atarak 'Lazım olur' demiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP07",
              "pointer": "/entities/4/facts/3"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-678e3ef503c92b0d",
      "text": "Meşrep Sarmagil ile birlikte Dev Fener Balığı'nın ağzındaki kozmik karanlıkta kaybolmuştur; nihai akıbeti belirsizdir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "owner_confirmation",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP07",
              "pointer": "/uncertainties/1"
            }
          ]
        }
      ]
    }
