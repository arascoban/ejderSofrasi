            }
          ]
        }
      ]
    },
    {
      "id": "FCT-3d1fdd7d63efb982",
      "text": "Kalender'i yakalayıp 28 hasarla komaya sokmuş, İto'yu göbeğinden ısırıp sıfır cana düşürmüş, ekibin ortak saldırısıyla öldürülmüştür.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP03",
              "pointer": "/entities/22/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-159f0ddeed6ba08c",
      "text": "Etleri tayfa tarafından yenmek üzere ayıklanmış, derisi ve dişi hatıra/ticaret için alınmıştır.",
