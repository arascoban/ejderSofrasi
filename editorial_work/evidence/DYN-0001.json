        "fact": {
          "id": "FCT-93fc17dc2983e2d8",
          "text": "Gandu olarak da adlandırılan demirci Rando, Akmer’e Helvacıoğlu Baltası’nı ve Kalender’e Kristal Kılıç’ı verir. Silahların Helvacıoğlu Hanedanı ve ejderha kemikleriyle bağı anlatılır.",
          "assertions": [
            {
              "period": "1300 civarı",
              "temporal_basis": "reviewed_source_context",
              "confidence": "source_supported",
              "source_refs": [
                {
