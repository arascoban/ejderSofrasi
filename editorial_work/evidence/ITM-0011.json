  "facts": [
    {
      "id": "FCT-3b675dea4b08bfee",
      "text": "Adnan Körkapak'ın Double Bottom bölümüne gizlediği, deri kese ve parşömen tüpü içindeki harita.",
      "assertions": [
        {
          "period": null,
