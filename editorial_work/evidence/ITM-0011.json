          ]
        }
      ]
    },
    {
      "id": "FCT-36c08bcf16d86162",
      "text": "Revanya Limanı ile Vhelin Adası (Latte Kasabası) arasındaki gizli bir adadaki hazineyi, adanın koordinatlarını, palmiyeleri, X işaretini, kuru kafa ve yaratık figürünü gösterir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP02",
              "pointer": "/entities/23/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-e8c24b9d71cadd20",
      "text": "Parşömenin arka yüzünde ada içindeki varış noktalarının çizimleri bulunmaktadır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP02",
              "pointer": "/entities/23/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-dd54755f2508c3b5",
      "text": "Haritadaki yaratık sembolü ejderha olarak yorumlanır; bu yorum kesin değildir.",
