  "facts": [
    {
      "id": "FCT-08d307703187baab",
      "text": "Divination (Uzgörü) okulunda kader üzerine yüksek lisans yapan, sürmeli gözlü, küpeli, uzun saçlı genç ve çapkın büyücüdür.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/6/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-58c26113f8136390",
      "text": "Roary'ye kur yapıp ona yas helvası ve çay ikram etmeye çalışmıştır; Papağan Cemil'in sahibidir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/6/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-5cb517ec99e99d0e",
      "text": "Arifler Okulu uzgörü öğrencisi genç büyücü.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP14",
              "pointer": "/entities/10/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-570c2ced6d6ee8cb",
      "text": "Roary'yi Arifler Okulu bahçesindeki kralların ve prenslerin gezdiği gül bahçesinde çay içmeye ve sohbet etmeye davet etmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP14",
              "pointer": "/entities/10/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-8d02b9b4e72c452e",
      "text": "Arifler Okulu uzgörü (divination) öğrencisi genç büyücü.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP15",
              "pointer": "/entities/5/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-bc551d25621c819f",
      "text": "Gül bahçesinde Roary ile gül yaprağı ve diken çayı içmiş, Roary'nin ricası üzerine kütüphanede araştırma yapıp halk mitinginde ekibin öte yansıtma (illüzyon/projection) görüntüsünü oluşturmayı kabul etmiştir.",
      "assertions": [
        {
          "period": null,
