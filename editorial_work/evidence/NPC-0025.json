    },
    {
      "id": "FCT-17e5540e4c56bc65",
      "text": "Geleneksel yemek ve sütlü tatlı süreçlerini zaman kaybı olarak görüp kısa yoldan hazır toz harçlar (kazandibi harcı, puding tozu, tost arası yemekler) ürettiği için hem ejderhalar hem de tanrılar tarafından lanetlenmiş ve sut denizinin dibine hapsedilmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "reviewed_source_context",
