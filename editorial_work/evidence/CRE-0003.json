  "facts": [
    {
      "id": "FCT-fd2446f3fe2b118b",
      "text": "Roary tarafından çağrılan, konuşabilen ve çekirdek/kuru yemiş hastası neşeli ve geveze bir papağandır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP04",
              "pointer": "/entities/6/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-27aca884e824b778",
      "text": "'Şampiyon Fener!', 'Ali Koç' gibi tuhaf insani ifadeler kullanmaktadır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP04",
              "pointer": "/entities/6/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-ace8c9354d294b90",
      "text": "Roary'nin tayfaya mesaj iletme ricasını anlamamış, sadece söylenen bazı kelimeleri tekrarlamıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP04",
              "pointer": "/entities/6/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-a04a69e6320d8ea1",
      "text": "Muzaffer Cemil'in yanında yaşayan evcil/arkadaş papağandır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP04",
              "pointer": "/entities/6/facts/3"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-78b9da2a260559c0",
      "text": "Muzaffer Cemil'in neşeli, yapraklardan mohak saç stiline ve siyah dile sahip papağanı.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP05",
              "pointer": "/entities/5/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-045c85f849fd111d",
      "text": "'Cemil', 'Şampiyon Fener' ve 'Ali Koç' kelimelerini tekrarlamaktadır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP05",
              "pointer": "/entities/5/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-bf7e908db0c98273",
      "text": "Roary'nin Beast Sense büyüsüyle labirent üzerinde uçarak havadan keşif yapmasını sağlamıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP05",
              "pointer": "/entities/5/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-601f317bc14d93e2",
      "text": "Gruptakilerin yanında süzülen, 'protein, protein' kelimelerini tekrarlayan geveze papağan.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP06",
              "pointer": "/entities/10/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-26e4f0c1f6d24140",
      "text": "Roary'nin yanında dolanan, 'Ablacığım, abiler gitmemiz lazım', 'Stradayım' gibi tuhaf terimler söyleyen geveze papağan.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP07",
              "pointer": "/entities/7/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-fba9354c31fa7f51",
      "text": "Ekibin yanındaki papağan.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
              "pointer": "/entities/34/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-04d0d71956da745c",
      "text": "Roary ile konuşup Dağ Kartalı'nın tepede uçtuğunu doğrulamış, Radam ile sohbet etmeye gitmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP11",
              "pointer": "/entities/8/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-f1980a8a1e237e73",
      "text": "Kahvaltıda ceviz, fındık, fıstık ve zeytin yiyen geveze papağan.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP12",
              "pointer": "/entities/12/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-4ce8c7136d0e9f8b",
      "text": "Roary'nin yanında dolanan geveze papağan.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP16",
              "pointer": "/entities/10/facts/0"
            }
          ]
        },
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP17",
              "pointer": "/entities/13/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-253b6e331f78b9a1",
      "text": "Kışla odasında kalan geveze papağan.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP19",
              "pointer": "/entities/13/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-f0c7618e54c31d86",
      "text": "Kışla odasında unutulan geveze papağan.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP20",
              "pointer": "/entities/30/facts/0"
            }
          ]
        }
      ]
    }
  ],
