      },
      {
        "fact_id": "FCT-61d9d951578a54b1",
        "entity_id": "EVT-0090",
        "fact": {
          "id": "FCT-61d9d951578a54b1",
          "text": "Roary rüyasında kadim bir rahibenin aşk, ihanet, düğün katliamı ve kadehe dönüşme hikâyesini görür. Bu bir rüya yoluyla açıklanan geçmiş iddiasıdır; olayın tarihi ve bağımsız doğruluğu bilinmez.",
          "assertions": [
