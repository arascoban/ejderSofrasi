  "facts": [
    {
      "id": "FCT-4df900ec1e2cf38a",
      "text": "Zümrüt Ejderha Şifa Tapınağı hazine odasındaki kristal yeşim kadeh; içinde kıpkırmızı bir sıvı barındırır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP07",
              "pointer": "/entities/11/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-27dbf6d703024453",
      "text": "Köpo Kurtoğlu tarafından kapılmış, boyut kargaşasında İto ve Kalender'e fırlatılmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP07",
              "pointer": "/entities/11/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-79294f89dcb22c4a",
      "text": "Tek parça yeşim taşından oyulmuş büyülü kadeh.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/17/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-e0729f486bafef05",
      "text": "Su doldurulursa günde 1 kez Potion of Supreme Healing (10d4+20 HP) üretir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/17/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-c41772ff577fbad7",
      "text": "Kendi kanın akıtılırsa (nekrotik hasar), 30 feet içindeki 6 müttefike 5. seviye Mass Cure Wounds büyüsü uygular.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/17/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-fb7e233d696db058",
      "text": "Pasif: Taşıyan kişiyi hastalık ve zehirlenmeye karşı bağışıklı kılar.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/17/facts/3"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-ecac9a595089d51d",
      "text": "İto ve Roary'nin taşıdığı büyülü kadeh.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
              "pointer": "/entities/29/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-a3adb370e758f27a",
      "text": "Roary ve ekibin taşıdığı, içine su doldurulup içildiğinde 10d4+20 HP şifa sağlayan tek parça yeşimden oyulmuş büyülü kadeh.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP11",
              "pointer": "/entities/17/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-66de314ae0c170db",
      "text": "Roary tarafından kışladaki yaralı askerleri iyileştirmek için su ile doldurularak dağıtılan büyülü şifa kadehi.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP12",
              "pointer": "/entities/28/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-3e641cf05860a673",
      "text": "Büyülü şifa kadehi.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP13",
              "pointer": "/entities/22/facts/0"
            }
          ]
        },
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP14",
              "pointer": "/entities/31/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-83c6e2c1a9f15138",
      "text": "Roary'nin Subira ve öğrencileri iyileştirmek için kullandığı şifa kadehi.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP15",
              "pointer": "/entities/35/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-d5f971563731491f",
      "text": "Roary'nin gece kederini hissettiği büyülü şifa kadehi.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP16",
              "pointer": "/entities/34/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-47295310740d089a",
      "text": "Roary'nin şifa kadehi.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP17",
              "pointer": "/entities/40/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-b21e0c3b9b2c8db7",
      "text": "Kışladaki odada kalan büyülü şifa kadehi.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP19",
              "pointer": "/entities/14/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-e26eee8c4fb31ddc",
      "text": "Kadeh lanetlidir; Azize’nin son anlarında yaşadığı eziyeti kullanıcısına rüya yoluyla tekrar tekrar yaşatır. Roary bu rüyanın ardından kadehi fırlatmıştır.",
      "assertions": [
        {
          "period": "1300 civarı",
          "temporal_basis": "owner_confirmation",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP16",
              "pointer": "/entities/3/facts/2"
            }
          ]
        }
      ]
    }
