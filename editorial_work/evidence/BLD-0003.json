  "facts": [
    {
      "id": "FCT-b7b2792f8975262b",
      "text": "Savaş Tanrısı Pastırman tarafından Çöl Şehri Surları önünde zemini yararak çıkarılan, Kalender Tütüncüoğlu'nu havaya kaldıran dökme demir devasa el/eldiven abidesi.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP13",
              "pointer": "/entities/18/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-f2501f1e529a3c0e",
      "text": "Çöl Şehri Surları önünde Pastırman'ın çıkardığı dev dökme demir eldivenin etrafında mumlar ve adaklar yakılarak sunaka dönüştürülen anıt alan.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP15",
              "pointer": "/entities/25/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-f226c0d43ed58e40",
      "text": "Çöl Şehri Surları önünde Pastırman'ın çıkardığı dev dökme demir eldivenin etrafında adaklar yakılan miting alanı.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP16",
              "pointer": "/entities/28/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-5878700d5f1a6901",
      "text": "EP13'te Pastırman tarafından zeminden çıkarılan, etrafında adaklar yakılan dev dökme demir eldiven anıtı; EP19'da Pastırman tarafından aniden yerin altına çekilip kaybolmuştur.",
      "assertions": [
        {
          "period": null,
