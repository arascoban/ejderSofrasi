  "facts": [
    {
      "id": "FCT-fa4815fdca798823",
      "text": "İto İtoğlu'nun sırtında yetişen, zırhı yararak dışarı çıkan, sivri balık dişlerine ve bilince sahip olan kozmik parazit canlı ağız.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP18",
              "pointer": "/entities/7/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-f53322f77f9b8b8a",
      "text": "Kendi ağzından 'Bana Yok Oluş Bey diyeceksiniz', 'Ben kaosum, karanlığım, yok oluşum' ifadelerini söylemiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP18",
              "pointer": "/entities/7/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-83a4332228f34605",
      "text": "Nezarethane koridorunda kışla muhafızlarından birinin iki parmağını ısırmış, kopardıktan sonra masaya tükürmüş ve arbedede muhafızlara saldırmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP18",
              "pointer": "/entities/7/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-69e7ff06862e002a",
      "text": "İto'nun sırtındaki kozmik parazit ağız; EP19 süresince uykuya dalmış ve tepki vermemiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP19",
              "pointer": "/entities/7/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-68deb1482d57f0a9",
      "text": "İto İtoğlu'nun sırtında büyüyen kozmik parazit canlı ağız.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP23",
              "pointer": "/entities/4/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-1d5e5111553f14b2",
      "text": "EP23'te uyanarak 'Burası çok lezzetli kokuyor, Kalender'in götünden bir parça ısırayım, vasat köpeği yiyeyim' diye bağırmış, Kalender sırtına vurunca susmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP23",
              "pointer": "/entities/4/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-f65c57d59bd20cc7",
      "text": "Kurutulmuş ve füme et kokularını duyduğunda acıktığını söyleyerek et ve pastırma talep etmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP23",
              "pointer": "/entities/4/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-e24fa65140a0c69c",
      "text": "İto İtoğlu'nun sırtında yaşayan, lezzetli yemek ve taze et kokularıyla çıldıran kozmik parazit canlı ağız.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP24",
              "pointer": "/entities/4/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-8da37eb3aacd98a8",
      "text": "5. salondaki nar ekşili, cevizli, sumaklı ve çemenli Gavurdağı Golemi'ni 'tanrıların ve yaratılışın nar ekşisi' olarak adlandırıp devasa ağzıyla gövdeye dalmış ve boss yaratığın canını yarı yarıya düşürmüştür.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP24",
              "pointer": "/entities/4/facts/1"
            }
          ]
        }
      ]
    }
  ],
