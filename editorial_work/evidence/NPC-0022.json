  "facts": [
    {
      "id": "FCT-fffd04c219fdf623",
      "text": "Yaz Helvası Krallığı'nda Çöl Şehri'nin 2. Sur/Kapı Komutanıdır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/4/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-5398b560ef606933",
      "text": "Şehir dışından gelen maceracıları ve 'Mehdi' iddialarını şüpheyle karşılayıp karargah hücrelerine aldırmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/4/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-cabb3c0f62bbc8b6",
      "text": "Şehrin kuyu suyundan pis su içtiği için dizanteri ve yüksek ateş geçiren 15-16 yaşlarında bir kızı vardır; Kalender ve ekip kızını iyileştirince maceracılara minnettar kalmış ve saraya gitmelerine rehberlik etmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
