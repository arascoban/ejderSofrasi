  "facts": [
    {
      "id": "FCT-6b681b7d04713978",
      "text": "Arifler Okulu'nun alt katlarındaki atölyede çalışan, siyah saçlı, kahverengi gözlü, demirci önlüğü ve koruyucu maske giyen kadın büyülü eşya ustası/büyücü.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP11",
              "pointer": "/entities/6/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-91421e8d375c6df9",
      "text": "Büyülü eşya yapımını, rün örgüsünü ve büyü doldurulabilen eşya mekaniğini bilmektedir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP11",
              "pointer": "/entities/6/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-ac66ae0fa978b0e3",
      "text": "Roary'nin kanından örnek alarak içine büyü enerjisi/ses yüklenebilen özel ok yapma denemesine başlamıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP11",
              "pointer": "/entities/6/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-040a7ef38b17af28",
      "text": "Arifler Okulu alt katındaki atölyede çalışan esmer, orta yaşlı, büyülü eşya ve rün uzmanı kadın büyücü.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP12",
              "pointer": "/entities/4/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-b0bba55668471af6",
      "text": "İto'nun kafasındaki tacın dış alemlerden lanetli bir balık paraziti olduğunu ilk görüşte anlamıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP12",
              "pointer": "/entities/4/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-6d9ae99ca9687d79",
      "text": "Akmer'in baltasını incelemiş, baltanın eski olduğunu ve büyü yüklenirse parçalanacağını söyleyerek yeni bir balta yaptırmasını önermiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP12",
              "pointer": "/entities/4/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-6a62c251c3c203b3",
      "text": "Kendisine 'Eyvah Mehdi'yim ben' diyerek böbürlenen Kalender'i dondurarak öğrencilerinin onun alçı kalıbını almasını sağlamıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP12",
              "pointer": "/entities/4/facts/3"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-d050ee94ff1dd642",
      "text": "Arifler Okulu büyülü eşya ve rün uzmanı; patlamada ağır yaralanmış, Roary'nin kadeh şifasıyla iyileşmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP15",
              "pointer": "/entities/9/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-2b59d5b6475ee8df",
      "text": "Arifler Okulu büyülü eşya ve rün uzmanı.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP16",
              "pointer": "/entities/7/facts/0"
            }
          ]
        },
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP18",
              "pointer": "/entities/10/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-06c531bdfbc51dc1",
      "text": "Ammon Hoca ve öğrencilerle birlikte Kalender için Full Plate Mail zırh ritüeli gerçekleştirmiş, Roary'ye değişken görünümlü büyülü deri zırh ve büyülü dövme teslim etmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP16",
              "pointer": "/entities/7/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-d4ef30a71ceadd07",
      "text": "Kalender'i model alan hedef heykellerinin okulun döner sermayesi tarafından üretildiğini açıklamıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP16",
              "pointer": "/entities/7/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-bfab84123403a2c6",
      "text": "Arifler Okulu büyülü eşya ve rün uzmanı; koridorlarda Kalender heykelleri yaptırmış, atölyesinde çalışmalar yürütmektedir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP17",
              "pointer": "/entities/7/facts/0"
            }
          ]
        }
      ]
    }
