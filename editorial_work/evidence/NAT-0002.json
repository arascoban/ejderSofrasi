  "facts": [
    {
      "id": "FCT-4d130b74f4b4ff23",
      "text": "Zümrüt Ejderha Şifa Zindanı içerisindeki 5 nolu zümrüt konteyner kapısından girilen ekstradimensiyonel cennet vadisi.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP05",
              "pointer": "/entities/19/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-16a79fc791b66947",
      "text": "Farklı iklimlerden ağaçları ve kuşları barındırır; deredeki suya bakıldığında kişiyi geçici olarak 25 yaş yaşlandırır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP05",
              "pointer": "/entities/19/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-e6333f05816b4236",
      "text": "Deresine damlatılan kan çimenleri büyütür, kana koşan balıkları şeytani canlılara, kaçan balıkları ise kutsal gümüş canlılara dönüştürür.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP05",
