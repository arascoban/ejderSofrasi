  "facts": [
    {
      "id": "FCT-df2d5c7ed49ec278",
      "text": "Kuşatma ordusunun ortasındaki 3 birliği oluşturan; başlangıçta flamasız, sonradan Pastırman'ın yumruğu flamalarını çıkaran, Kavurhan Satıroğlu önderliğindeki berserker kuvvetleri.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP17",
              "pointer": "/entities/33/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-bbb2d94579bd03ad",
      "text": "Kavurhan Satıroğlu önderliğindeki, çölün ortasında kamp kurmuş olan ve gece Çöl Şehri'ne genel taarruz başlatan Pastırmancı berserker ordusu.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP19",
              "pointer": "/entities/20/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-7a3eb6d6708eb526",
      "text": "Kavurhan Satıroğlu önderliğinde dev ayı, pastırma flamaları ve çemen buhurdanlıklarıyla 1. Bölge'ye hücum eden berserker kuvvetleri.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP20",
              "pointer": "/entities/24/facts/0"
            }
          ]
        }
      ]
    }
