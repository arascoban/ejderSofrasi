      "text": "Siyah Ejderha ordusuna bağlı, egzotik kıvrık kılıçlar, oklar ve maskeler taşıyan, ikili ve koordine savaş eğitimine sahip 8 kişilik özel suikast ve pusu birliği.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
