  "facts": [
    {
      "id": "FCT-a34db821c0bf2922",
      "text": "Yaz Helvası Krallığı'nın kadim soylu ailelerinden Helvacıoğulları (Helvacıadeler) hanedanına mensup, Yaz Helvası'ndan kovulmuş zengin asilzade.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP21",
              "pointer": "/entities/4/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-6c852b80f5e83620",
      "text": "Kervansaray'ın 2. katındaki lüks odada sarı zırhlı 4 özel korumasıyla konaklamakta ve han müşterileri arasında huzursuzluk çıkarmaktadır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP21",
              "pointer": "/entities/4/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-bac89de59127794d",
      "text": "Odasında büyücü bir kadınla yatakta helva yerken İto İtoğlu tarafından odasına sızılıp boğazı kesilerek öldürülmüş, cesedi Dev Kurbağa formundaki Roary tarafından yutulmuştur.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP21",
              "pointer": "/entities/4/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-f617f65cd3c888ae",
      "text": "Helvacıoğlu Hanedanı (Helvacıadeler) mensubu, EP21'de İto tarafından öldürülen asilzade.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP22",
              "pointer": "/entities/4/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-5b70809d4cfb55a5",
      "text": "Kilitli günlüğünde Yaz Helvası sarayındaki genç bir soylu/kraliyet mensubuyla yaşadığı gizli platonik aşk yüzünden şehirden kovulduğunu, Kızıl Komutan'ın (Sancar Devran) 'gün gelir devran döner, şehirden uzaklaşma' talimatı üzerine Tahin Saray Kervansarayı'nda beklediğini yazmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP22",
              "pointer": "/entities/4/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-b89fd6775924095a",
      "text": "İto tarafından sahte veda mektubu yazılarak çöle kaçmış gibi gösterilmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP22",
              "pointer": "/entities/4/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-b43d4d8d36dd1a50",
      "text": "EP21/EP22'de öldürülen soylu; ekibin 5000+ altınını aldığı Helvacıoğlu mensubu.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP23",
              "pointer": "/entities/30/facts/0"
            }
          ]
        }
      ]
    }
  ],
