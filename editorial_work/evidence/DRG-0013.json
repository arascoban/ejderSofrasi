  "facts": [
    {
      "id": "FCT-35ef6528440fef7a",
      "text": "Yeraltından çıkan, kasırga, yıkım, savaş ve korkuyu temsil eden, şehri kuşatan karanlık güçlerin arkasındaki siyah ejderha.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
              "pointer": "/entities/15/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-94d8537650624a65",
      "text": "Yeraltı, yıkım ve kasırga ejderhası; Un Helvası ordusu ve Siyah Ejderha tarikatı bu ejderhanın emrindedir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP10",
              "pointer": "/entities/21/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-59da31e0fb82a490",
      "text": "Gökyüzünde yıldızların ötesindeki kozmik karanlığı temsil eden, yeraltı ve yıkım ejderhası.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP12",
              "pointer": "/entities/16/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-51bd3a74068abb32",
      "text": "Yeraltı ve yıkım ejderhası; Un Helvası Krallığı ordusu bu ejderhanın etkisindedir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP13",
              "pointer": "/entities/11/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-de2b131151257f81",
