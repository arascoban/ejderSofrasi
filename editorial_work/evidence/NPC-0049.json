  "facts": [
    {
      "id": "FCT-364ef8e0e06616cd",
      "text": "Zümrüt Ejderha Şifa Tapınağı'nda yüzyıllardır nöbet tutan, yeşil-beyaz cübbeli, yeşim asalı, at kuyruklu saçlara sahip son derece çevik ve güçlü keşiş/muhafız.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP06",
              "pointer": "/entities/4/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-1d4994a6a2ca1f01",
      "text": "Tapınağa gelen yolcuları sınamakla görevlidir; sıcak yeşil çay içmeyi sever.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP06",
              "pointer": "/entities/4/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-c6b7667f6fd20fbd",
      "text": "Roary'yi üst platforma taşıyarak 'Şifa sadece bedensel değil ruhsaldır, başkalarından yardım almayı öğrenmektir' mesajını vermiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP06",
              "pointer": "/entities/4/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-e9a82c1213057cbf",
      "text": "Zümrüt Ejderha Şifa Tapınağı'nın muhafızı.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP07",
              "pointer": "/entities/6/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-0954ba35e9c0ef3a",
      "text": "Akmer ve Roary'ye kaybolan arkadaşları için yardım edemeyeceğini, olay yerinde Astralum Tozu kaldığını ve farklı boyutların kesiştiğini belirtmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP07",
              "pointer": "/entities/6/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-648219251f62e7fe",
      "text": "Akmer'e yeşil çay ve papatya kokulu mendil vermiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP07",
              "pointer": "/entities/6/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-7f0b92ec971b68f9",
      "text": "Gruba 4 kollu kapı bulmacasında yardımlaşmaları gerektiği ipucunu vermiş, sınav geçildikten sonra yasemin yaprakları halinde kaybolmuştur.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP07",
              "pointer": "/entities/6/facts/3"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-9057ef1ce4fb13e9",
      "text": "Roary'nin vizyonunda %60 opacity ruh formunda beliren Yeşim Ejderha tapınak görevlisi/rahibi.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP23",
              "pointer": "/entities/5/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-9eb96164c4b9c5dd",
      "text": "Roary'ye maceracıların henüz büyük sınavın (tapınak sınavı) içinde olduklarını, haritadan ve tapınak sınırlarından dışarı çıktıklarında zamanın durduğunu ve alemin renderlanmadığını söyleyerek onları uyarmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP23",
              "pointer": "/entities/5/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-33cc2acee4ef6744",
      "text": "Yaşı bilinmemektedir; tapınakta çok uzun süredir nöbet tutmaktadır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "owner_confirmation",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP06",
              "pointer": "/uncertainties/2"
            }
          ]
        }
      ]
    }
  ],
