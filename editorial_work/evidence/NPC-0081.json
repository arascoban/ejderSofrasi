  "facts": [
    {
      "id": "FCT-bfff6d5aa105fd61",
      "text": "Karapancar gemisinde tayfadır; eskiden ana kıtada at arabası sürerken cinayet işleyip denizci olmuştur.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP01",
              "pointer": "/entities/7/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-2aba268c1d81a344",
      "text": "Dünyadan umudunu kesmiş, hırsı veya paraya hevesi olmayan son derece gamsız ve rahat bir tiptir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP01",
              "pointer": "/entities/7/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-e7ef4cd53bb2ec1d",
      "text": "Ekibe Karapancar gemisinin alt katlarının ve double bottom geçidinin tarifini yapmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP01",
              "pointer": "/entities/7/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-f4702326f86df9cf",
      "text": "Karapancar gemisinde tayfadır; Çima, Çoma, Ispavlo ve Gırcıla ile 5 denizci kardeş olduklarını belirtmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP02",
              "pointer": "/entities/4/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-831f87337f435091",
      "text": "Kaptan kamarasındaki tüfekleri ele geçirerek gemide köleler ve tayfalar arasında kan dökülmesini engellemek istemiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP02",
              "pointer": "/entities/4/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-11fa1fdc4c6afaf7",
      "text": "İto'ya yakın mesafeden blunderbuss tüfeğiyle ateş ederek onu ağır yaralamıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP02",
              "pointer": "/entities/4/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-00f2946f882a4669",
      "text": "Kalender Tütüncüoğlu'nun Divine Smite yüklü kılıç darbesiyle ikiye bölünerek öldürülmüştür.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP02",
              "pointer": "/entities/4/facts/3"
            }
          ]
        }
      ]
    }
  ],
