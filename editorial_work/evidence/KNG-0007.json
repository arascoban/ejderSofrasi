  "facts": [
    {
      "id": "FCT-615099223d6cf70b",
      "text": "Helvanar Kıtası'nda yer alan, karanlık ritüeller, nekromansi ve ölüm büyücüleriyle ilgilenen, İrmik Helvası Krallığı ve Kırmızı Ejderha ile ittifak kurarak Yaz Helvası Krallığı'nı kuşatan krallık.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/9/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-a8fec0c743f07dd6",
      "text": "Helvanar Kıtası döneminde (1300 civarı) Siyah Ejderha tarikatıyla işbirliği yaparak Yaz Helvası Krallığı'nı ve Çöl Şehri'ni kuşatan krallık.",
