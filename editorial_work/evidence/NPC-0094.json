  "facts": [
    {
      "id": "FCT-53a05487d9177c2f",
      "text": "Gümüş Ejderha Tapınağı'nda çalışan, payetli ve gümüş pullu beyaz cübbe giyen genç rahip.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
              "pointer": "/entities/4/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-aa646b6691ae1679",
      "text": "Maceracıların farklı zamandan ve Pastırman/Narkader gibi tanrılardan geldikleri yönündeki sözlerini uydurma ve saygısızca bularak onları tapınaktan kovmuştur.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
              "pointer": "/entities/4/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-54b065a0c9792cba",
      "text": "Gümüş Ejderha'nın ticaret, şifa, insanlara yönelme ve ışık yönünü temsil ettiğini, tapınaktaki hareketli vitrayın 9 ejderhanın kozmik döngüsünü gösterdiğini anlatmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
              "pointer": "/entities/4/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-d4be3bda38e5d300",
      "text": "Yeşim rahipleri arasında alt kademe rütbededir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "owner_confirmation",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
