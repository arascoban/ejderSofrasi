  "facts": [
    {
      "id": "FCT-5593c59cb661b9a5",
      "text": "Kartal Sniper tarafından Niani'yi vurmakta kullanılan, iki parçalı metalden özel imal edilmiş, uzun mesafeli ve dengeli yüksek kaliteli suikast okları.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP10",
              "pointer": "/entities/17/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-549f6b324ef60b3d",
      "text": "Kartal Sniper tarafından kullanılan, ustalıkla işlenmiş, yüksek isabetli ve büyü yüklenmeye uygun kaliteli demirci okları.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP11",
              "pointer": "/entities/18/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-4df5d5fde963f026",
      "text": "Devran için özel olarak üretilmiş, Sancar Devran'ı vurmakta kullanılan 4 adet kaliteli ve dengeli suikast oku.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
