  "facts": [
    {
      "id": "FCT-c17ae931a7e50b80",
      "text": "Evrenin ana panteonunda yer alan Kader Tanrıçasıdır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP00",
              "pointer": "/entities/9/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-d753a8858d3273e8",
      "text": "Simgesi nardır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP00",
              "pointer": "/entities/9/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-05dffd3de0f4e75a",
      "text": "Kader tanrıçasıdır; simgesi nardır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP02",
              "pointer": "/entities/16/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-f065f62c720e1f0c",
      "text": "Evrenin ana tanrıçasıdır; doğum, ölüm, kader, kehanet ve evrendeki denge (karma/ilahi adalet) konularına bakar.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP03",
              "pointer": "/entities/11/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-9f17def2ad6ee751",
      "text": "Simgesi nardır. Bu evrendeki halk kadere ve dengeye yürekten inanır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP03",
              "pointer": "/entities/11/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-f22299e8864f5163",
      "text": "Kader ve denge tanrıçası.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
              "pointer": "/entities/10/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-5ccd5e0d9aeeb988",
      "text": "Helvanar evreninin merkez tanrıçası; kader, denge ve her durumun zıddıyla dengelenmesi ilkesine bakan ulu tanrıça.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP23",
              "pointer": "/entities/14/facts/0"
            }
          ]
        }
      ]
    }
