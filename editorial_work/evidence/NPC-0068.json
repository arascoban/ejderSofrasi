  "facts": [
    {
      "id": "FCT-95b7a243e8e096c1",
      "text": "Zümrüt Ejderha pulunun ve şifa zindanının 100 yılı aşkın süredir nöbetçisi ve muhafızı olan yaşlı, beyaz sakallı, pelerinli ve asalı büyücüdür.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP04",
              "pointer": "/entities/7/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-883aacf6ccca05d0",
      "text": "Asasıyla ateş yakabilir ve dokunduğu canlıların tüm yaralarını anında iyileştirebilir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP04",
              "pointer": "/entities/7/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-80931647318f77fc",
      "text": "Yaşadığı yerin Tanrılar ile Ejderhalar arasındaki Büyük Savaş'ta yaralanan Zümrüt Ejderha'nın gökyüzünden düşen devasa bir pulunun (Zümrüt Ejderha Pulu) üzeri olduğunu açıklamıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP04",
              "pointer": "/entities/7/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-1d919c87852b0be2",
      "text": "Kulübesinin içinden Zümrüt Ejderha Şifa Zindanı'na inen bir merdiven bulunmaktadır; zindanın bekçisidir ancak içeri hiç inmemiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP04",
              "pointer": "/entities/7/facts/3"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-35bd2e3b672d6e6e",
      "text": "Adayı ve pulun sırrını başkalarına haritayla veya sözle ifşa edenlerin ejderhaların lanetine uğrayacağını belirtmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP04",
              "pointer": "/entities/7/facts/4"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-da53e06293482bbb",
      "text": "Zümrüt Ejderha Şifa Zindanı'nın nöbetçisi olan kadim büyücü.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP05",
              "pointer": "/entities/4/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-2c9dc50ae3697750",
      "text": "Maceracılara zindanda yollarını bulmaları ve kapıları açmaları için Şampiyonların Feneri adındaki özel asayı vermiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP05",
              "pointer": "/entities/4/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-8ad1661487e3c9a3",
      "text": "Zindana giren kahramanların sevdiklerine bıraktıkları mektupları sakladığı yüzyıllık bir mektup sandığı bulunmaktadır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP05",
              "pointer": "/entities/4/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-2ccf2570766079fe",
      "text": "Kulübesinin arkasındaki ağılda uzun süredir şampiyon olamamış mutsuz bir koç (Ali Koç) beslemektedir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP05",
              "pointer": "/entities/4/facts/3"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-abcb9fd38250310e",
      "text": "Zindanda zaman ve mekanın büküldüğünü, girilen kapıdan geri çıkış olmadığını ve başka bir kıtada çıkılabileceğini uyarmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP05",
              "pointer": "/entities/4/facts/4"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-1fadd53fc22d045c",
      "text": "Kadim Zümrüt Ejderha tapınağının koruyucusudur.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "owner_confirmation",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP04",
              "pointer": "/uncertainties/0"
            }
          ]
        }
      ]
    }
  ],
