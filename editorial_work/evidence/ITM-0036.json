  "facts": [
    {
      "id": "FCT-3fa97b4ecec03883",
      "text": "Hazine odasında metal işlemeli minimalist bir taç gibi görünen, ancak gerçekte Dev Fener Balığı'nın bedenine bağlı olta uzvu (lure) olan ilüzyonlu nesne.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP06",
              "pointer": "/entities/9/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-1825e14307f6b674",
      "text": "Hazine odasından kurtarılan büyülü taç.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP07",
              "pointer": "/entities/12/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-03645e93b98c584d",
      "text": "Kristalize saf ışıktan asılı taç.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/20/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-5d6c54e1ed0ff0fd",
      "text": "Taşıyana 120 feet karanlıkta görüş ve Insight zarlarına +5 bonus verir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/20/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-3b28f193c7213b34",
      "text": "Parlatıldığında (bonus action) 30 feet içindeki düşmanları DC 17 Con saving throw ile 1 dakika kör eder (günde 3 kez).",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/20/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-d5174acb75a4c6d6",
      "text": "Günde 1 kez 6. seviye Sunbeam (yeşim renkli radyan ışın) ateşler.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/20/facts/3"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-484837459740ec53",
      "text": "Kalender'in taşıdığı, parlatıldığında düşmanları kör eden kızıl ışın saçan büyülü taç.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
              "pointer": "/entities/27/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-2353a9e7fbeecb77",
      "text": "İto tarafından aktifleştirilip 6. seviye Sunbeam (28 radyan damage) ışını fırlatarak Siyah Ejderha cambazlarını kör eden ve yakan büyülü taç.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP10",
              "pointer": "/entities/18/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-34df7d22bd95140d",
      "text": "İto'nun kafasında taşıdığı, ortasında büyük kırmızı bir göz ve etrafında minik balık gözleri barındıran, kas/tendon dokularıyla kafatasına yapışmış grotesque lanetli eşya.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP12",
              "pointer": "/entities/27/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-2dcfeb702cb540fc",
      "text": "İto'nun algısını ve zihin okuma yeteneğini artırır, ancak taşıyıcının zihnini ve bedenini kademeli olarak etkiler.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP12",
              "pointer": "/entities/27/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-19964b802452fd36",
      "text": "İto'nun kafasında parazit gibi büyüyen, Sunbeam ışını fırlatarak kışla koridorundaki askerleri kör eden büyülü taç.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP13",
              "pointer": "/entities/20/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-07874684b58282ea",
      "text": "İto'nun kafasındaki grotesk lanetli eşya.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP14",
              "pointer": "/entities/29/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-a0ab434377128c6e",
      "text": "İto'nun kafasındaki Sunbeam ışını fırlatarak rooftop suikastçılarını yakan büyülü parazit taç.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP15",
              "pointer": "/entities/33/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-9af213da4ba629fd",
      "text": "İto'nun kafasındaki Sunbeam kızıl lazer fırlatan parazit taç.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP17",
              "pointer": "/entities/38/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-e398ce3dfa2927e5",
      "text": "İto'nun kafasındaki büyülü parazit taç.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP18",
              "pointer": "/entities/26/facts/0"
            }
          ]
        }
      ]
    }
