  "facts": [
    {
      "id": "FCT-89f5cf415154c094",
      "text": "Helvacıoğlu Hanedanı'ndan kalma, uzun siyah ahşap saplı, bakır işlemeli, 2d6 hasarlı ve +1 bonuslu kadim savaş baltası; Rando tarafından Akmer'e hediye edilmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP15",
              "pointer": "/entities/27/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-c191db9edb759aa1",
      "text": "Helvacıoğlu Hanedanı tarafından ejderha mezarlığından getirilen kadim ejderha kemiklerinden dövülmüş, tırtıklı kenarlı ve rünlü dev kılıç; Rando tarafından Kalender'e teslim edilmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP15",
              "pointer": "/entities/28/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-0b91acc8602a908c",
      "text": "Kristal Kılıç'ın Akmer'in kanı ve öfkesiyle dönüşerek ortaya çıkardığı, Akmer'in canına (50 HP) bağlanan kadim, rünlü, çift elli ejderha kemiği savaşı baltası.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP16",
              "pointer": "/entities/29/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-794112dadd3a1e7d",
      "text": "Akmer'in taşıdığı ejder kemiği baltası.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP17",
              "pointer": "/entities/36/facts/0"
            }
          ]
        },
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP21",
              "pointer": "/entities/18/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-d0027970e463dec5",
      "text": "Akmer'in Ejderhalar Sofrası Harabeleri'nde kan akıttığı ejder kemiği baltası.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP23",
              "pointer": "/entities/31/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-9d3cde8b1ab6a6eb",
      "text": "Akmer'in taşıdığı, Ejder Öldürücü (Dragon-Slayer) özelliğe sahip, Gavurdağı Golemi'ni yararak Ametist Kristali'ni ortaya çıkaran ejder kemiği baltası.",
      "assertions": [
        {
