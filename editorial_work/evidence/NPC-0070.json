    },
    {
      "id": "FCT-42aa1894499af052",
      "text": "Çatışmada silahını bırakıp kaçmaya çalışırken Kalender Tütüncüoğlu tarafından yakalanıp sorgulanmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
