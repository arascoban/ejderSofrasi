            {
              "source_id": "SRC-EP10",
              "pointer": "/entities/5/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-659653fa0de7414d",
      "text": "Ordularına Mehdi'yi (Kalender) bulmaları, esir alıp 'namussuzlar adına çalışmama ve kendi tanrısına ihanet etmeme' mesajını iletmeleri emri verildiğini açıklamıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP10",
              "pointer": "/entities/5/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-65425156410e9e35",
      "text": "Siyah Ejderha tarikatına bağlı gizli cambaz liderlerini çağırmak için özel ıslık çalmış, ıslığın ardından 150-180 metre öteden surlardaki nişancı tarafından boğazından iki özel okla vurularak öldürülmüştür.",
      "assertions": [
        {
          "period": null,
