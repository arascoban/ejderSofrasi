  "facts": [
    {
      "id": "FCT-05ff19ad66f767b5",
      "text": "Çöl Şehri'nin 3. katında yer alan, buz kristali gibi yükselen yarı şeffaf taşlardan yapılmış, üzerinde devasa gümüş ejderha heykeli bulunan, gün ışığını prizma gibi kırıp tüm mahalleye renkli ışıklar saçan heybetli bilim ve ibadet tapınağı.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/12/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-5d72299320d63c00",
      "text": "Çöl Şehri'nin 3. katında yer alan, buzdan/kristalden oyulmuş devasa ejderha heykeli şeklinde yükselen, kapısı olmayan, içerisinde 9 ejderhanın kozmik döngüsünü gösteren hareketli dev vitray bulunan tapınak.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
              "pointer": "/entities/22/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-0b9851879f11a015",
      "text": "Dışarıda kuşatma olmasına rağmen içi son derece temiz, kokusuz ve huzurlu bir atmosfere sahiptir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
              "pointer": "/entities/22/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-fd517842640e1de2",
      "text": "Çöl Şehri 3. Bölgesi'nde yer alan, elmas/kristal görünümlü, içerisinde tüm ejderhaların mabetlerini barındıran huzurlu devasa katedral.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP16",
              "pointer": "/entities/26/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-7319f80cff1d1759",
      "text": "Çöl Şehri 3. Bölgesi'nde yer alan tapınak.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP18",
