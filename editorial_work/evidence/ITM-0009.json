  "facts": [
    {
      "id": "FCT-4a5b6ac576ca2fbb",
      "text": "Zümrüt Ejderha Şifa Tapınağı hazine odasındaki 3 büyülü nesneden biri; bakırın yeşile döndüğü, minik yeşim işlemeli, 6 delikli ve zincirli buhurdanlık.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP07",
              "pointer": "/entities/10/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-90336ced42efdd3a",
      "text": "Akmer ve Roary tarafından seçilmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP07",
              "pointer": "/entities/10/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-6ac0153270fc774e",
      "text": "6 delikli yeşim zincirli buhurdanlık.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/18/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-bd879a7cc1e4c95e",
      "text": "Sallandığında 30 feet alana 1 dakika süren yeşil sis yayar; içindeki dostlar her tur 2d6 HP iyileşir ve nekrotik direnç kazanır (günde 1 kez).",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/18/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-88c56888ef73bf3e",
      "text": "Günde 3 kez 20 feet içindeki dostların körlük, felç, zehirlenme durumlarını siler.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/18/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-30813a524155309d",
      "text": "Pasif: 30 feet yakınındaki dostlar 0 HP'ye düştüğünde otomatik stabilize olur.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/18/facts/3"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-f5e5f5b25050ce57",
      "text": "Akmer ve Roary tarafından taşınan, yeşil şifalı duman yayan büyülü eşya.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
              "pointer": "/entities/26/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-7eefca73398668d1",
      "text": "Roary tarafından kullanılarak çatışma alanına şifalı yeşil sis yayan (her tur 2d6 HP iyileşme) büyülü buhurdanlık.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP10",
              "pointer": "/entities/19/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-83ffe715414f138d",
      "text": "Roary tarafından Çöl Şehri 2. Bölgesi'nde kullanılarak yeşil şifalı duman yayılan, körlük, felç ve sağırlığı iyileştiren büyülü eşya.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP12",
              "pointer": "/entities/29/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-800050bf4cdb94e1",
      "text": "Roary tarafından miting alanında sallanarak yeşil şifalı sis yayılan büyülü buhurdanlık.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP13",
              "pointer": "/entities/19/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-f945e23ad2469508",
      "text": "Büyülü şifa buhurdanlığı.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP14",
              "pointer": "/entities/30/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-5b4261c336b48449",
      "text": "Roary'nin patlama sonrasında etrafa yeşil şifalı sis yayarak yaralıları iyileştirdiği büyülü buhurdanlık.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP15",
              "pointer": "/entities/34/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-b65b992c653cc3f0",
      "text": "Akmer tarafından Gümüş Ejderha Tapınağı'nda yakılan şifa buhurdanlığı.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP16",
              "pointer": "/entities/35/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-72b63f101d676320",
      "text": "Roary'nin şifa buhurdanlığı.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP17",
              "pointer": "/entities/39/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-21a4b20fa111d59e",
      "text": "Roary'nin kışla koridorunda yeşil şifalı sis yaymak için kullandığı büyülü eşya.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP18",
              "pointer": "/entities/27/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-600b914ca00cd146",
      "text": "Akmer'in sinirle kumların arasına fırlattığı, Roary'nin Locate Object ile arayıp kum altında kaldığı için bulamadığı şifalı buhurdanlık.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP20",
              "pointer": "/entities/18/facts/0"
            }
          ]
        }
      ]
    }
