          ]
        }
      },
      {
        "fact_id": "FCT-27dec2c7cd934185",
        "entity_id": "EVT-0076",
        "fact": {
          "id": "FCT-27dec2c7cd934185",
          "text": "Kalender hasta kızı iyileştirir; Roary Durgunluk Buhurdanı ve şifa kadehiyle mahalle halkına ve yaralı askerlere yardım eder. Bu faaliyetler Pastırman ve Ördek-ül Şifa hareketlerinin yayılmasını sağlar.",
          "assertions": [
            {
              "period": "1300 civarı",
              "temporal_basis": "reviewed_source_context",
              "confidence": "source_supported",
              "source_refs": [
