  "facts": [
    {
      "id": "FCT-121608a7874f80e1",
      "text": "Kültürü, mimarisi ve ekonomisi revani ve şerbetli tatlılar etrafında şekillenmiş krallık/şehir devleti.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP00",
              "pointer": "/entities/16/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-38a8f5844c2df01b",
      "text": "Şerbetli tatlılar, revani ve limon temalı kültürü olan krallık.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP01",
              "pointer": "/entities/13/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-5a4dd20ac37048d9",
      "text": "Büyü kullanımı gümrük vergisine tabidir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP01",
              "pointer": "/entities/13/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-0da961b036122db8",
      "text": "Revanya limanının bulunduğu, şerbetli tatlı ve limon temalı kültüre sahip krallık.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP02",
              "pointer": "/entities/17/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-60b90797dc9bfebc",
      "text": "Revanya Limanı'nın bulunduğu krallık; Akmer'in başına 5000 altın ödül konduğu iddia edilmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP03",
