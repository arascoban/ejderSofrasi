  "facts": [
    {
      "id": "FCT-063f1e7f4e5eb4f4",
      "text": "Tanrılar ile ejderhalar arasındaki Büyük Savaş'ta yaralanan Zümrüt Ejderha'nın gökyüzünden düşen ve Gizemler Adası'nda yer alan devasa pulu.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP04",
              "pointer": "/entities/11/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-a9f66ecffb5551a3",
      "text": "Üzerinde mermer benzeri cilalı sert zemin, liken/yosun kaplı toprak ve gürül gürül akan şifalı su kaynağı barındırır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP04",
              "pointer": "/entities/11/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-47c96f4764c02a65",
      "text": "Üzerinde duran canlılara muazzam bir kutsallık, şifa aurası ve büyü gücü artışı sağlar.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP04",
              "pointer": "/entities/11/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-f2782fdaa974a146",
      "text": "Üzerinde Muzaffer Cemil'in kulübesi bulunan ve altında şifa zindanına inen kapaklar barındıran devasa ejderha pulu.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP05",
              "pointer": "/entities/15/facts/0"
            }
          ]
        }
      ]
    }
  ],
