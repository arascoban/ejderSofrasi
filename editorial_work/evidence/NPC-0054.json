  "facts": [
    {
      "id": "FCT-9954b0fd222038e7",
      "text": "Pastırman inancının antik, radikal ve efsanevi komutanı; 2.10m boyunda (Enlarge ile 2.60m'ye çıkan), et parçaları, kafatasları ve kurumuş pastırmalarla kaplı kan sızan büyülü siyah dikenli zırh giyen, 2.10m'lik devasa Greatsword taşıyan savaşçı.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP17",
              "pointer": "/entities/4/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-6c7f1401169a3c75",
      "text": "Çöl Şehri 1. Duvarı önünde er dileyip Kalender Tütüncüoğlu ile teke tek duelloya tutuşmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP17",
              "pointer": "/entities/4/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-79a978e9be13f1d6",
      "text": "Dövüş sırasında Banishment büyüsüyle Kalender'i Pastırman'ın kozmik boyutuna göndermiş, Akmer'in müdahalesiyle geri getirmiş, kafası kılıçla kesilmesine rağmen rejenerasyon gücüyle konuşmaya ve savaşmaya devam etmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP17",
              "pointer": "/entities/4/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-81fc16f43b53ef3f",
      "text": "Kalender'in zaferini ve yiğitliğini kabul edip savaşı 1 günlüğüne durdurmuş, er meydanında saha çadırı kurdurmuş ve Kalender'e hatıra olarak kendi serçe parmağını vermiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP17",
              "pointer": "/entities/4/facts/3"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-d7a9dcea71437a1f",
      "text": "Pastırman inancının radikal antik komutanı.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP18",
              "pointer": "/entities/9/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-696fe5d65f867732",
      "text": "EP17'deki duellonun ardından ertesi gün er meydanındaki saha çadırında pazarlık yapmak üzere ordusunda beklemektedir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP18",
              "pointer": "/entities/9/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-3a94994910b18465",
      "text": "Pastırman inancının radikal ve efsanevi başkomutanı.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP19",
              "pointer": "/entities/4/facts/0"
            }
          ]
        },
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP20",
              "pointer": "/entities/4/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-605a7c85a3d41572",
      "text": "Gece çöl kampına tek başına gelen Kalender Tütüncüoğlu'nu ağırlamış, ona ikramda (kutsal çemen) bulunmuştur.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP19",
              "pointer": "/entities/4/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-8a9b5be0e7efbeea",
      "text": "Kalender'in dövüldüğünü ve Sancar Devran'ın öldürüldüğünü öğrenince öfkelenerek Çöl Şehri'ne karşı genel savaş emri vermiş ve savaş borularını çaldırmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP19",
              "pointer": "/entities/4/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-6ead8916db1ab614",
      "text": "Kutsal yadigar kutusundan çıkardığı dikenli Çemenin Kılıcı'nı Kalender'e vererek onu ordusunun ön safına katmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP19",
              "pointer": "/entities/4/facts/3"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-573d504dcb7f175b",
      "text": "Dev ayısının üzerinde, pastırma flamaları ve çemen buhurdanlıklarıyla Çöl Şehri'ne genel taarruz başlatmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP20",
              "pointer": "/entities/4/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-64d244a7c971c2b8",
      "text": "Siyah Ejderha Ordusu'nu öne sürerek 1. Bölge surlarını ve kapılarını yıkmış, şehri ele geçirmeye başlamıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP20",
              "pointer": "/entities/4/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-97ceeebf8584b5e6",
      "text": "Kalender'in kaçtığını görünce onun intikamını almak bahanesiyle şehri yerle bir edeceğini ilan etmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP20",
              "pointer": "/entities/4/facts/3"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-39edb94df49f9e46",
      "text": "Pastırman inancının radikal başkomutanı.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP22",
              "pointer": "/entities/18/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-5f9475c0d73da2a1",
      "text": "Kalender'in revirde hekime adını vermesi üzerine Hekim tarafından kendisine ulak/haber gönderilmiştir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP22",
              "pointer": "/entities/18/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-05ad04058018c83f",
      "text": "Gelecekte hangi tarafı seçeceği ve fetih yönü bilinmemektedir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "owner_confirmation",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP17",
              "pointer": "/uncertainties/0"
            }
          ]
        }
      ]
    }
  ],
