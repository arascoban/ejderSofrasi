    "summary_facts": [
      {
        "fact_id": "FCT-5ca32f1e2e73f962",
        "entity_id": "EVT-0032",
        "fact": {
          "id": "FCT-5ca32f1e2e73f962",
          "text": "Kalender, Kavurhan Satıroğlu ile Çöl Şehri'nin ilk suru önünde düello yapar; arkadaşları müdahale eder. Kavurhan'ın başı kesilir fakat rejenerasyonla yaşamaya devam eder.",
          "assertions": [
            {
              "period": "1300 civarı",
              "temporal_basis": "reviewed_source_context",
              "confidence": "source_supported",
              "source_refs": [
                {
                  "source_id": "SRC-EP17",
                  "pointer": "/entities/1/facts/1"
                },
                {
                  "source_id": "SRC-EP17",
                  "pointer": "/entities/1/facts/3"
                },
                {
                  "source_id": "SRC-EP17",
                  "pointer": "/entities/4/facts/2"
                }
              ]
            }
          ]
        }
      },
      {
        "fact_id": "FCT-8c677d53c4bddbd4",
        "entity_id": "EVT-0033",
        "fact": {
          "id": "FCT-8c677d53c4bddbd4",
          "text": "Kavurhan, Kalender'i Banishment ile Pastırman'ın kozmik savaş boyutuna yollar; Akmer'in baskısı sonucunda geri çağırır.",
          "assertions": [
            {
              "period": "1300 civarı",
              "temporal_basis": "reviewed_source_context",
              "confidence": "source_supported",
              "source_refs": [
                {
                  "source_id": "SRC-EP17",
                  "pointer": "/entities/1/facts/2"
                },
                {
                  "source_id": "SRC-EP17",
                  "pointer": "/entities/0/facts/2"
                }
              ]
            }
          ]
        }
      },
      {
        "fact_id": "FCT-72944933a65d8a69",
        "entity_id": "EVT-0034",
        "fact": {
          "id": "FCT-72944933a65d8a69",
          "text": "Kavurhan, Kalender'in yiğitliğini kabul ederek savaşı bir gün durdurur. Komutanlar ve maceracılar saha çadırında görüşür; Kalender serçe parmağını hatıra alır.",
          "assertions": [
            {
              "period": "1300 civarı",
              "temporal_basis": "reviewed_source_context",
              "confidence": "source_supported",
              "source_refs": [
                {
                  "source_id": "SRC-EP17",
                  "pointer": "/entities/4/facts/3"
                },
                {
                  "source_id": "SRC-EP17",
                  "pointer": "/entities/5/facts/2"
                }
              ]
            }
          ]
        }
      },
      {
        "fact_id": "FCT-94d9462d9e4ab9a3",
        "entity_id": "EVT-0042",
        "fact": {
          "id": "FCT-94d9462d9e4ab9a3",
          "text": "Kalender gece çölü tek başına geçerek Kavurhan'ın kampına gider ve Sancar'ın öldürülmesini anlatır. Kavurhan genel savaş emri verir.",
          "assertions": [
            {
              "period": "1300 civarı",
              "temporal_basis": "reviewed_source_context",
              "confidence": "source_supported",
              "source_refs": [
                {
                  "source_id": "SRC-EP19",
