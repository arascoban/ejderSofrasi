      {
        "fact_id": "FCT-df8194aba40ec817",
        "entity_id": "EVT-0043",
        "fact": {
          "id": "FCT-df8194aba40ec817",
          "text": "Kavurhan kutsal kılıcı Kalender'e verir. Dikenli kabza eline saplandığında Kalender'in savaş gücü ve Paladin aurası geri gelir.",
          "assertions": [
            {
              "period": "1300 civarı",
              "temporal_basis": "reviewed_source_context",
              "confidence": "source_supported",
              "source_refs": [
                {
