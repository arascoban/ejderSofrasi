  "facts": [
    {
      "id": "FCT-68f4231bef47d008",
      "text": "Hulusi'nin 2. kattaki odasında onunla beraber helva yiyen, Web (Örümcek Ağı), Scorching Ray ve Misty Step büyülerini kullanabilen büyücü kadın.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP21",
              "pointer": "/entities/5/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-c3c7d8e56c2c9338",
      "text": "Hulusi öldürüldüğünde panikleyerek Web büyüsüyle odayı kaplamış, Scorching Ray ile Roary'ye 22 hasar vermiş, ancak yakalandıktan sonra Hulusi ile derin bir bağı olmadığını söyleyerek İto ve Roary ile sessizlik anlaşması yapmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP21",
              "pointer": "/entities/5/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-1d963c0326c36f39",
      "text": "Hulusi'nin kervansaraydaki yan odasında kalan ve Hulusi'nin günlüğünde adından bahsettiği büyücü kadın.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP22",
              "pointer": "/entities/5/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-da75d12ff8d6a861",
      "text": "EP21'deki arbedenin ardından odadan ayrılmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP22",
