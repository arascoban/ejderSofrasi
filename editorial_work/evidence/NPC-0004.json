      {
        "fact_id": "FCT-7407d96500dc8d13",
        "entity_id": "EVT-0011",
        "fact": {
          "id": "FCT-7407d96500dc8d13",
          "text": "Akmer'in başına konan ödülü tayfaya duyuran kaptan, İto tarafından okla öldürülür; cesedi denize atılır.",
          "assertions": [
            {
