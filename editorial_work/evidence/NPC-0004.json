  "facts": [
    {
      "id": "FCT-e5e73a317c444119",
      "text": "Karapancar isimli ticaret gemisinin kaptanıdır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP00",
              "pointer": "/entities/4/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-1fd4d93778e61db5",
      "text": "Kendisini Rusman / O'Rusman olarak tanıtır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP00",
              "pointer": "/entities/4/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-2dd1829f750d0d01",
      "text": "Sinirli, sefil giyimli ve gümrük vergilerine tepkili bir denizcidir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP00",
              "pointer": "/entities/4/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-d9c432a55c9b6fa6",
      "text": "Karapancar gemisinin kaptanıdır, şalgam içip tütün çiğner.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP01",
              "pointer": "/entities/4/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-1feacce8f1c5cf73",
      "text": "Kaliteli Doblin uyuşturucusuyla başlayıp işleri bozuldukça ucuz Doblin kullanımına düşmüş ve zihinsel melekelerini kaybetmeye başlamıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP01",
              "pointer": "/entities/4/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-ffe46c791801b4aa",
      "text": "Jurnalinde vurgun parasını ve hazine haritasını Karapancar'ın double bottom bölümüne sakladığını yazmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP01",
              "pointer": "/entities/4/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-5670e10799c5191e",
      "text": "Akmer tarafından yumrukla bayıltıldıktan sonra elleri ayakları bağlanarak ibret olsun diye ana direğin gözcü yerine (karga yuvasına) ters asılmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP01",
              "pointer": "/entities/4/facts/3"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-de6d59b4cab03468",
      "text": "Karapancar gemisinin bağımlı kaptanıdır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP02",
              "pointer": "/entities/12/facts/0"
            }
          ]
        },
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP03",
              "pointer": "/entities/4/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-061d5df4b81c783f",
      "text": "Ana direğin karga yuvasına ters asılı halde uyanarak tayfaya ve ekibe bağırmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP02",
              "pointer": "/entities/12/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-3d0dc9621d331886",
      "text": "Karga yuvasına ters asılı halde uyanıp tayfaya Akmer'in kafasında 5000 altın ödül olduğunu bağırırken İto tarafından okla kafasından vurularak öldürülmüştür.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP03",
              "pointer": "/entities/4/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-bfed510127eead59",
      "text": "Cesedi tayfa tarafından denize atılmıştır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP03",
              "pointer": "/entities/4/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-5378f57202ae4f58",
      "text": "Karapancar'ın eski kaptanı.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP04",
              "pointer": "/entities/22/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-24d10be09b9dc206",
      "text": "Tayfaya haftalık 5 gümüş ödeme/borç miktarı aktarılır; miktarın kesinliği yoktur.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "owner_confirmation",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP01",
              "pointer": "/uncertainties/1"
            }
          ]
        }
      ]
    }
