  "facts": [
    {
      "id": "FCT-44b843e5764c6b16",
      "text": "Yaz Helvası Krallığı'nın ana koruyucu ve adalet tanrısı/ejderhası. Tapınağı şehre ışık saçmaktadır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
