  "facts": [
    {
      "id": "FCT-5d46c225cf3caa89",
      "text": "Hazine odasındaki üç nesneden biri olan, üzerinde Zümrüt Ejderha kabartması bulunan, Akmer tarafından seçildiğinde parmağına uyum sağlayıp zindelik ve ferahlık veren büyülü yüzük.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP06",
              "pointer": "/entities/7/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-1366b0478611b936",
      "text": "Akmer'in taktığı büyülü yüzük.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP07",
              "pointer": "/entities/13/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-8d0b0617b0329031",
      "text": "Savaş dışında her 10 dakikada 1d6 HP yeniler; kopan uzuvları 1d4 günde yeniden çıkarır.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/19/facts/0"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-f799496f16b36ab8",
      "text": "Sıra dışı 0 HP'ye düşüldüğünde anında 1 HP ile ayağa kaldırır ve 10 feet alandaki düşmanlara 2d10 radyan patlama hasarı verir.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/19/facts/1"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-6f615fdc2b2c4b27",
      "text": "Ölen kişinin etrafında 24 saatte yeşim kozası oluşturup Reincarnate büyüsüyle tam canlı diriltir (yüzük parçalanır).",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP08",
              "pointer": "/entities/19/facts/2"
            }
          ]
        }
      ]
    },
    {
      "id": "FCT-b9ed64ef63de8ae1",
      "text": "Akmer'in parmağındaki büyülü yüzük.",
      "assertions": [
        {
          "period": null,
          "temporal_basis": "not_established",
          "confidence": "source_supported",
          "source_refs": [
            {
              "source_id": "SRC-EP09",
              "pointer": "/entities/28/facts/0"
            }
          ]
        },
        {
          "period": null,
          "temporal_basis": "not_established",
