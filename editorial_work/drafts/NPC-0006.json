  "document": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Akmer Sütçüoğlu, "
          },
          {
            "type": "text",
            "text": "Sütçüoğlu Ailesi'nin prensesi ve varisi",
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "entityId": "FAM-0004",
                  "href": "/entity/FAM-0004"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " olarak kaydedilen ve Ancestral Guardian sınıfında barbar bir savaşçı olarak tanımlanan bir kişidir."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Geçmişi ve kaçışı"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Kaynaklara göre ailesinden, ailenin ineklerini ve süt kompleksini özgürleştirmek amacıyla kaçtı. Bu kaçışın ardından kendisinin canlı getirilmesi şartıyla bir ödül kondu."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Karapancar yolculuğu"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Revanya’dan ayrılırken "
          },
          {
            "type": "text",
            "text": "Karapancar",
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "entityId": "SHP-0001",
                  "href": "/entity/SHP-0001"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " gemisine 27,5 altın karşılığında bindi. Gemide "
          },
          {
            "type": "text",
            "text": "Adnan Körkapak",
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "entityId": "NPC-0046",
                  "href": "/entity/NPC-0046"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " ile yaşanan çatışmanın ardından idareyi ele geçirip kendisini yeni kaptan ilan etti."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Şifa zindanı ve Yaz Helvası"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Şifa zindanı sürecinde Akmer, "
          },
          {
            "type": "text",
            "text": "Kalender Tütüncüoğlu",
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "entityId": "NPC-0051",
                  "href": "/entity/NPC-0051"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " ile dostane bir düello yaptı ve zindandaki olayların ardından ekip ile birlikte "
          },
          {
            "type": "text",
            "text": "Yaz Helvası Şehri",
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "entityId": "CIT-0006",
                  "href": "/entity/CIT-0006"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " bağlamına çıktı. Bu kayıtlar, karşılaşmaların ve bulunulan yerlerin dönemini her olay için ayrı tutar."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Eşyalar ve sonraki olaylar"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Akmer, Şifa zindanındaki üç nesneden "
          },
          {
            "type": "text",
            "text": "Yeniden Yaşam Yüzüğü",
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "entityId": "ITM-0031",
                  "href": "/entity/ITM-0031"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": "nü seçip taktı. Daha sonra Demirci Rando’dan "
          },
          {
            "type": "text",
            "text": "Helvacıoğlu Baltası",
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "entityId": "ITM-0012",
                  "href": "/entity/ITM-0012"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": "nı aldı; Durgunluk Buhurdanı’nı ise çölde öfkeyle fırlattığı kaynaklarda yer alır."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Kaynak sınırları"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Akmer’in bazı seyahat kayıtlarında başlangıç, varış veya yol arkadaşlarının kimliği kesinleştirilemez. Bu belirsizlikler burada kapatılmamış, ilgili kaynak çatışmalarıyla birlikte korunmuştur."
          }
        ]
      }
    ]
  },
  "period": null,
