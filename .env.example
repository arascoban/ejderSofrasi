# Supabase Connect ekranındaki proje değerleri. Publishable key tarayıcıda kullanılabilir;
# yetkiyi PostgreSQL/Storage RLS politikaları sınırlar.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep "enabled" after D2 migrations are applied. Use "disabled" for an explicit
# read-only deploy while the linked Supabase project is still empty.
SUPABASE_EDITORIAL_MODE=enabled

# Yalnızca sunucu tarafı medya rotası ve yönetim/davet işlemleri için; tarayıcı paketine asla eklenmez.
# SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
